# =============================================================================
# WorldCup System — environment example (SAFE TO COMMIT)
# =============================================================================
# Copy for local Docker Compose only:
#   cp .env.example .env
#
# NEVER commit a real .env. NEVER put production passwords or JWT secrets here.
# Production inventory (required keys + placeholders):
#   docs/changes/phase-14-secrets.md
#   (VitePress) or WorldCup-System/docs/changes/phase-14-secrets.md (git mirror)
# CORS / JWT production wiring:
#   docs/changes/phase-14-cors.md
# Production Compose override:
#   docs/changes/phase-14-compose.md
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#   (requires PROD_* env vars — not the Local Docker section names)
# =============================================================================

# --- Local Docker Compose (Development) ------------------------------------
# Weak defaults for casual `docker compose up` only. Do not use on a shared host.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=WorldCupDb

API_PORT=5055

JWT_SECRET=docker-dev-jwt-secret-key-at-least-32-characters
JWT_VALID_ISSUER=http://localhost:5000
JWT_VALID_AUDIENCE=http://localhost:4200

# Semicolon-separated SPA origins (no trailing slash). Maps to Cors__AllowedOrigins.
CORS_ALLOWED_ORIGINS=http://localhost:4200

DEV_ADMIN_EMAIL=admin@localhost
DEV_ADMIN_PASSWORD=Admin123!

DEV_USER_EMAIL=user@localhost
DEV_USER_PASSWORD=User123!

# --- Production (host / secret store — DO NOT uncomment with real values) ---
# ASP.NET Core env names (double underscore). Set on the server, not in git.
#
# ASPNETCORE_ENVIRONMENT=Production
# ConnectionStrings__DefaultConnection=Host=REPLACE_ME_DB_HOST;Port=5432;Database=REPLACE_ME_DB;Username=REPLACE_ME_USER;Password=REPLACE_ME_PASSWORD
# JWT__Secret=REPLACE_ME_JWT_SECRET_AT_LEAST_32_CHARS
# JWT__ValidIssuer=https://api.REPLACE_ME.example
# JWT__ValidAudience=https://app.REPLACE_ME.example
# Cors__AllowedOrigins=https://app.REPLACE_ME.example
# Multiple origins: Cors__AllowedOrigins=https://app.REPLACE_ME.example;https://www.REPLACE_ME.example
# Or indexed: Cors__AllowedOrigins__0=https://app.REPLACE_ME.example
#
# Omit DevAdmin__* and DevUser__* in Production (seed runs only in Development).
# Origin form: scheme + host [+ port], NO trailing slash. Do not use *.
#
# Production Compose (do NOT reuse the Local Docker section values above).
# Prod override requires PROD_* names so a Dev `.env` cannot silently satisfy them:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Set host env: PROD_POSTGRES_USER, PROD_POSTGRES_PASSWORD, PROD_POSTGRES_DB,
# PROD_JWT_SECRET, PROD_JWT_VALID_ISSUER, PROD_JWT_VALID_AUDIENCE,
# PROD_CORS_ALLOWED_ORIGINS (all required).
# Detail: docs/changes/phase-14-compose.md
#
# Example (placeholders only — do not commit real values):
# PROD_POSTGRES_USER=REPLACE_ME_USER
# PROD_POSTGRES_PASSWORD=REPLACE_ME_STRONG_DB_PASSWORD
# PROD_POSTGRES_DB=WorldCupDb
# PROD_JWT_SECRET=REPLACE_ME_JWT_SECRET_AT_LEAST_32_CHARS
# PROD_JWT_VALID_ISSUER=https://api.REPLACE_ME.example
# PROD_JWT_VALID_AUDIENCE=https://app.REPLACE_ME.example
# PROD_CORS_ALLOWED_ORIGINS=https://app.REPLACE_ME.example
